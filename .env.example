# MeterFlo environment variables
#
# Copy this file to `.env` (in the install root) and fill in real values.
# `.env` is gitignored, so the secrets you put in it stay out of source control.
# `.env.example` is committed and must contain ONLY safe placeholders.
#
# In production, the server loads `.env` automatically on startup (via dotenv,
# imported at the top of server/index.ts), so you do NOT need to duplicate any
# of these in deploy/ecosystem.config.cjs. PM2's `env` block overrides values
# from `.env`, so adding secrets there silently defeats this file.

# --- Required ---

# Postgres connection string for the application database.
# URL-encode any special characters in the password (see Section 3.2 of
# deploy/WINDOWS_DEPLOYMENT.md).
DATABASE_URL=postgresql://meterflo_user:CHANGE_ME@localhost:5432/meterflo

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Server binding ---

# 'production' enables built static asset serving and disables Vite dev server.
NODE_ENV=production

# Bind to loopback so port 3000 is only reachable from this machine. Apache
# proxies public traffic in from ports 80/443. See Section 5 of the guide.
HOST=127.0.0.1

# Port the Node process listens on. Must match the Apache ProxyPass target.
PORT=3000

# Cookie security flag. Leave 'false' on plain HTTP. Set to 'true' ONLY after
# HTTPS is configured (Section 9). Setting 'true' on HTTP silently breaks login.
COOKIE_SECURE=false

# --- Optional ---

# Password for the SMTP account used to send contact/support emails.
# Only required if you've configured outbound email in
# Settings > Contact & Support Forms. Leave blank or remove if unused.
SMTP_PASSWORD=

# Override the directory where pg_dump / pg_restore are looked up. Only set if
# the PostgreSQL bin folder is not already on the system PATH (Section 2.2).
# PG_BIN_PATH=C:\Program Files\PostgreSQL\16\bin

# Override where application log files are written. Defaults to the `logs/`
# folder inside the install root.
# LOG_DIR=

# Emergency bypass for Cloudflare Turnstile verification on the login form.
# Leave UNSET in production. Only set to a known shared value when Turnstile
# is misbehaving and you need to recover.
# TURNSTILE_EMERGENCY_BYPASS=
